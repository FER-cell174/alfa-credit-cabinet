{
  "info": {
    "name": "Умный кредитный кабинет — API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Порядок: 1) три запроса входа, 2) создать заявку, 3) отправить, 4) получить карточку. Переменная appId заполняется после создания."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "appId",
      "value": "1"
    },
    {
      "key": "clientToken",
      "value": ""
    },
    {
      "key": "operatorToken",
      "value": ""
    },
    {
      "key": "analystToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Вход",
      "item": [
        {
          "name": "Клиент",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"client@demo.test\",\n  \"password\": \"client123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('clientToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
